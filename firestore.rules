rules_version = '2';
// Pixel Normal Edit — Firestore Security Rules
// Deploy: firebase deploy --only firestore:rules
//
// Cấu trúc đúng:
//   mcp_sessions (collection)
//     └── {sessionId} (document = UUID)
//           └── commands (subcollection)
//                 └── {docId} (command document)
//
// TTL auto-cleanup: bật trong Firebase Console
//   Firestore → Data → TTL Policies → Add TTL Policy
//   Collection group: commands    Field: expiresAt
service cloud.firestore {
  match /databases/{database}/documents {

    // MCP sessions — chỉ cho phép UUID-format session ID
    match /mcp_sessions/{sessionId}/commands/{docId} {
      function validSession() {
        return sessionId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$') || sessionId.matches('^[a-zA-Z0-9_-]{8,}$');
      }
      
      // Read & delete không có request.resource
      allow read, delete: if validSession();
      
      // Create & update mới kiểm tra dung lượng (max 50KB)
      allow create, update: if validSession() && request.resource.size() < 50 * 1024;
    }

    // Cho phép đọc/ghi document mcp_sessions/{sessionId} (heartbeat)
    match /mcp_sessions/{sessionId} {
      allow read, write: if sessionId.matches('^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$') || sessionId.matches('^[a-zA-Z0-9_-]{8,}$');
    }

    // Block ALL other collections
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
